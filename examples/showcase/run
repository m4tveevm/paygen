#!/usr/bin/env bash
set -euo pipefail

ROOT=$(cd "$(dirname "$0")/../.." && pwd)
OUT=${1:-"$ROOT/tmp/showcase-$(date -u +%Y%m%dT%H%M%SZ)-$$"}
PORT=${PAYGEN_DEMO_PORT:-9293}
BASE="http://127.0.0.1:$PORT"
PROJECT="$OUT/novapay"
PID=""

say() { printf '\n\033[1;36m==> %s\033[0m\n' "$*"; }
die() { printf 'showcase: %s\n' "$*" >&2; exit 1; }
stop() { if [[ -n "$PID" ]] && kill -0 "$PID" 2>/dev/null; then kill "$PID"; wait "$PID" || true; fi; }
trap stop EXIT INT TERM
mkdir -p "$OUT" || die "output parent is not writable"
[[ -z "$(find "$OUT" -mindepth 1 -maxdepth 1 -print -quit)" ]] || die "output must be a new or empty directory: $OUT"
cd "$ROOT"

say '[CASE] S1: inspect, initialize and generate from the pinned NovaPay source'
bundle exec bin/paygen inspect fixtures/novapay/openapi.yaml --profile fixtures/novapay/integration.yml --format json > "$OUT/inspect.json"
bundle exec bin/paygen init fixtures/novapay/openapi.yaml --output "$PROJECT" > "$OUT/init.json"
bundle exec bin/paygen configure "$PROJECT" > "$OUT/configure.json"
bundle exec bin/paygen generate "$PROJECT" > "$OUT/generate.json"
bundle exec bin/paygen generate "$PROJECT" > "$OUT/regenerate.json"
bundle exec bin/paygen diff "$PROJECT" --check > "$OUT/diff.json"
ruby -c "$PROJECT/generated/novapay_service.rb" | tee "$OUT/ruby-syntax.txt"
sha256sum fixtures/novapay/openapi.yaml "$PROJECT/generated/novapay_service.rb" "$PROJECT/generated/INTEGRATION.md" "$PROJECT/generated/fixtures.json" > "$OUT/artifact-sha256.txt"

say '[PROJECT POLICY] S3-S4: start the real HTTP application; it loads generated Ruby'
if ruby -rsocket -e "s=TCPServer.new('127.0.0.1',$PORT);s.close" 2>/dev/null; then :; else die "port $PORT is already in use; refusing to stop another process"; fi
bundle exec bin/paygen demo "$PROJECT" --port "$PORT" > "$OUT/demo.log" 2>&1 & PID=$!
ready=0
for _ in $(seq 1 80); do
  if curl --noproxy '*' -fsS "$BASE/health" > "$OUT/health.json" 2>/dev/null; then ready=1; break; fi
  kill -0 "$PID" 2>/dev/null || { cat "$OUT/demo.log" >&2; die 'demo exited before readiness'; }
  sleep .1
done
[[ "$ready" == 1 ]] || die 'demo readiness exceeded 8 seconds'

say '[CASE] Repeat create/retry/status/callback assertions three times in shared state'
for n in 1 2 3; do
  ID="showcase-$n-$(date +%s)-$$"
  before=$(curl --noproxy '*' -fsS "$BASE/evidence")
  create=$(curl --noproxy '*' -fsS "$BASE/operations" -H 'Content-Type: application/json' -d "{\"id\":\"$ID\",\"amount\":\"1500.00\",\"currency\":\"RUB\",\"payout_requisite\":{\"sbp\":{\"phone\":\"79990000001\",\"bank_code\":\"000000000\"}}}")
  retry=$(curl --noproxy '*' -fsS "$BASE/operations/$ID/retry" -H 'Content-Type: application/json' -d '{}')
  status=$(curl --noproxy '*' -fsS "$BASE/operations/$ID")
  events=$(curl --noproxy '*' -fsS "$BASE/events/$ID")
  printf '%s\n' "$before" > "$OUT/run-$n-before.json"; printf '%s\n' "$create" > "$OUT/run-$n-create.json"
  printf '%s\n' "$retry" > "$OUT/run-$n-retry.json"; printf '%s\n' "$status" > "$OUT/run-$n-status.json"; printf '%s\n' "$events" > "$OUT/run-$n-events.json"
  ruby -rjson -e 'c=JSON.parse(File.read(ARGV[0]));r=JSON.parse(File.read(ARGV[1])); abort "retry changed provider ID" unless c["success"] && c["provider_id"]==r["provider_id"]' "$OUT/run-$n-create.json" "$OUT/run-$n-retry.json"
  ruby -rjson -ropenssl -e 'e=JSON.parse(File.read(ARGV[0]))["events"].last; secret="paygen-test-secret"; expected=OpenSSL::HMAC.hexdigest("SHA256",secret,e["raw_body"]); actual=e["headers"].to_h["X-NovaPay-Signature"]; abort "independent HMAC mismatch" unless expected==actual' "$OUT/run-$n-events.json"
  ruby -rjson -rnet/http -ruri -e '
    event=JSON.parse(File.read(ARGV[1]))["events"].last; uri=URI(ARGV[0]+"/callbacks")
    send_event=lambda do |signed|
      req=Net::HTTP::Post.new(uri); req["Content-Type"]="application/json"; req.body=event["raw_body"]
      event["headers"].each { |name,value| req[name]=value } if signed
      Net::HTTP.start(uri.host,uri.port,nil,nil,nil,nil) { |http| http.request(req) }
    end
    invalid=send_event.call(false); abort "invalid callback was not rejected" unless invalid.code=="422"
    valid=send_event.call(true); abort "valid callback failed" unless valid.code=="200"
    File.write(ARGV[2],JSON.pretty_generate({http_status:invalid.code.to_i,body:JSON.parse(invalid.body)}))
    File.write(ARGV[3],JSON.pretty_generate({http_status:valid.code.to_i,body:JSON.parse(valid.body)}))
  ' "$BASE" "$OUT/run-$n-events.json" "$OUT/run-$n-invalid-callback.json" "$OUT/run-$n-valid-callback.json"
done
curl --noproxy '*' -fsS "$BASE/evidence" > "$OUT/evidence-final.json"
ruby -rjson -e 'e=JSON.parse(File.read(ARGV[0])); abort "expected exactly three provider commits" unless e["created_count"]==3' "$OUT/evidence-final.json"

say '[PROJECT POLICY] S5: prove managed-file drift refusal on a disposable project copy'
cp -a "$PROJECT" "$OUT/drift-project"
printf '\n# deliberate presenter edit\n' >> "$OUT/drift-project/generated/novapay_service.rb"
set +e; bundle exec bin/paygen generate "$OUT/drift-project" > "$OUT/drift.stdout" 2> "$OUT/drift.stderr"; drift_exit=$?; set -e
[[ "$drift_exit" == 1 ]] || die "expected drift refusal exit 1, got $drift_exit"

say '[PROJECT POLICY] S6: deterministic state fuzzer report and replay'
bundle exec bin/paygen fuzz "$PROJECT" --seed 4242 --cases 12 --steps 8 --output "$OUT/fuzz.json" > "$OUT/fuzz.stdout.json"
ruby -rjson -e 'r=JSON.parse(File.read(ARGV[0])); trace={"version"=>1,"seed"=>4242,"case"=>0,"mode"=>"normal","profile_sha256"=>r.fetch("profile_sha256"),"steps"=>%w[create retry poll callback duplicate stale].map{|a|{"action"=>a}}}; File.write(ARGV[1],JSON.pretty_generate(trace))' "$OUT/fuzz.json" "$OUT/fuzz-trace.json"
bundle exec bin/paygen fuzz "$PROJECT" --replay "$OUT/fuzz-trace.json" > "$OUT/fuzz-replay.json"

say '[CASE/Q&A] S7: generate four materially different profiles'
for provider in stripe paypal adyen; do
  bundle exec bin/paygen init "fixtures/$provider/openapi.yaml" --output "$OUT/$provider" > "$OUT/$provider-init.json"
  bundle exec bin/paygen generate "$OUT/$provider" > "$OUT/$provider-generate.json"
  bundle exec bin/paygen diff "$OUT/$provider" --check > "$OUT/$provider-diff.json"
done

git rev-parse HEAD > "$OUT/tested-sha.txt"
ruby -rjson -e 'puts JSON.pretty_generate({status:"PASS",note:"Synthetic loopback evidence, not PSP settlement or production certification",outputs:ARGV[0]})' "$OUT" | tee "$OUT/summary.json"
say "Complete. Keep these reports: $OUT"
