{
  "name": "paygen-docs",
  "private": true,
  "scripts": {
    "docs:render": "node script/docs-clean.cjs && node --require ./script/diplodoc-compat.cjs ./node_modules/@diplodoc/cli/build/index.js -i docs -o docs/_build",
    "docs:build": "npm run docs:render && bundle exec ruby script/docs_provider_assets.rb docs/_build && node script/docs-site-check.cjs docs/_build /paygen/",
    "docs:check": "node script/docs-site-check.cjs docs/_build /paygen/",
    "docs:test": "node --require ./script/diplodoc-compat.cjs --test ./script/diplodoc-compat.test.cjs"
  },
  "devDependencies": {
    "@diplodoc/cli": "5.39.4"
  },
  "engines": {
    "node": ">=22.13.0 <23",
    "npm": ">=11.9.0 <12"
  },
  "overrides": {
    "@diplodoc/client": "5.7.3",
    "@diplodoc/cut-extension": "1.1.1",
    "@diplodoc/tabs-extension": "3.10.0",
    "@diplodoc/transform": "4.75.3",
    "@diplodoc/translation": "1.7.22",
    "decode-uri-component": "0.5.0",
    "fast-xml-parser": "5.11.1",
    "js-yaml": "4.3.2",
    "katex": "0.16.47",
    "lodash": "4.18.1",
    "markdown-it": "14.3.1",
    "svgo": "3.3.5"
  },
  "packageManager": "npm@11.9.0"
}
