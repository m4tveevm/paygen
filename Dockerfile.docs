FROM ruby:4.0.6-slim AS provider-assets
ARG PAYGEN_SOURCE_SHA
ENV PAYGEN_SOURCE_SHA=$PAYGEN_SOURCE_SHA
ENV BUNDLE_FROZEN=true BUNDLE_WITHOUT=development:test
WORKDIR /src
# Native Ruby dependencies (json, bigdecimal, nio4r) need a compiler in this stage.
RUN apt-get update && apt-get install -y --no-install-recommends build-essential libyaml-dev \
    && rm -rf /var/lib/apt/lists/*
COPY Gemfile Gemfile.lock paygen.gemspec ./
COPY lib ./lib
COPY bin ./bin
COPY recipes ./recipes
COPY fixtures/novapay ./fixtures/novapay
COPY script/docs_provider_assets.rb ./script/docs_provider_assets.rb
RUN gem install bundler -v 4.0.20 --no-document && bundle install --jobs 4 --retry 3
RUN mkdir -p /assets && bundle exec ruby script/docs_provider_assets.rb /assets

FROM node:22.22.0-slim AS build
WORKDIR /docs
RUN npm install --global npm@11.9.0
COPY package*.json ./
RUN npm ci --ignore-scripts --engine-strict
COPY docs ./docs
COPY script/diplodoc-compat.cjs script/docs-clean.cjs script/docs-normalize.cjs script/docs-site-check.cjs ./script/
RUN npm run docs:render
COPY --from=provider-assets /assets/downloads ./docs/_build/downloads
COPY --from=provider-assets /assets/version.json ./docs/_build/version.json
RUN node script/docs-site-check.cjs docs/_build /paygen/ --seal \
    && node script/docs-site-check.cjs docs/_build /paygen/
FROM nginx:stable-alpine
COPY script/docs-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /docs/docs/_build /usr/share/nginx/html/paygen
EXPOSE 80
