FROM node:22-slim AS build
WORKDIR /docs
RUN npm install --global npm@11.9.0
COPY package*.json ./
RUN npm ci --ignore-scripts --engine-strict
COPY docs ./docs
COPY script/diplodoc-compat.cjs ./script/diplodoc-compat.cjs
RUN npm run docs:build
FROM nginx:stable-alpine
COPY --from=build /docs/docs/_build /usr/share/nginx/html
EXPOSE 80
