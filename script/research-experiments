#!/usr/bin/env ruby
# frozen_string_literal: true

# Optional, finite research probes. This script does not define release gates.
require 'digest'
require 'fileutils'
require 'json'
require 'open3'
require 'rbconfig'
require 'time'
require_relative '../src/lib/paygen'

# Four bounded, replayable evidence probes with per-command logs and no core edits.
# Long linear probes keep setup, action and independent assertions together.
# rubocop:disable-next Metrics/ClassLength, Metrics/AbcSize, Metrics/MethodLength
class ResearchExperiments
  ROOT = File.expand_path('..', __dir__)

  def initialize(output = nil)
    @output = File.expand_path(
      output || "tmp/research-experiments/run-#{Time.now.utc.strftime('%Y%m%dT%H%M%S')}-#{Process.pid}", ROOT
    )
    allowed_root = File.join(ROOT, 'tmp/research-experiments/')
    unless @output.start_with?(allowed_root)
      raise ArgumentError, 'Choose a new output directory under tmp/research-experiments'
    end
    raise ArgumentError, 'Output already exists; prior evidence must not be overwritten' if File.exist?(@output)

    FileUtils.mkdir_p(@output)
    @commands = []
    @experiments = []
    @started = Time.now.utc.iso8601
    @source_sha = git('rev-parse', 'HEAD').strip
    @dirty = git('status', '--porcelain', '--untracked-files=normal').lines.map(&:chomp)
    @core_before = manifest(File.join(ROOT, 'src/lib'))
  end

  def run
    check('E02', 'Identical generated bytes in two independent project directories') { independent_generation }
    check('E03', 'Equivalent YAML/JSON produce equal semantic IR, config and fixture data') do
      serialization_equivalence
    end
    check('E04', 'Manual generated drift is refused and user-owned extensions survive regeneration') { ownership }
    check('E05', 'Pinned native PayPal/Paystack onboarding and independent HTTP examples require no core edits') do
      native_profiles
    end
    report = {
      schema_version: 1, scope: 'E02-E05 only; optional research, not complete release acceptance',
      tested_sha: @source_sha, dirty_state: @dirty.empty? ? 'clean' : 'dirty', dirty_paths: @dirty,
      script_sha256: Digest::SHA256.file(__FILE__).hexdigest,
      started_at_utc: @started, finished_at_utc: Time.now.utc.iso8601,
      environment: { ruby: RUBY_DESCRIPTION, platform: RUBY_PLATFORM,
                     bundler: defined?(Bundler) ? Bundler::VERSION : 'not loaded',
                     node: 'not used', container: 'not used',
                     network: 'local files only; native HTTP examples intercepted by WebMock',
                     cache: 'existing dependencies; this is not a cold-start timing experiment',
                     seed: 42, budget: 'four finite experiments; no comparative fuzz budget' },
      reproduce: 'src/run exec ruby script/research-experiments',
      lock_sha256: Digest::SHA256.file(File.join(ROOT, 'src/Gemfile.lock')).hexdigest,
      core_before_sha256: @core_before, core_after_sha256: manifest(File.join(ROOT, 'src/lib')),
      commands: @commands, experiments: @experiments,
      future_studies: { E06: 'NOT_RUN: matched-budget stateful/stateless comparison',
                        E08: 'NOT_RUN: cold/warm timing study' },
      success: @experiments.all? { |experiment| experiment[:verdict] == 'PASS' }
    }
    write_json('report.json', report)
    write_json('artifact-sha256.json', manifest(@output))
    puts JSON.pretty_generate({ success: report[:success], report: File.join(@output, 'report.json'),
                                experiments: @experiments.map { |row| row.slice(:id, :verdict) } })
    report[:success] ? 0 : 1
  end

  private

  def check(id, expected)
    observed = yield
    @experiments << { id: id, expected: expected, verdict: 'PASS', observed: observed }
  rescue StandardError => e
    @experiments << { id: id, expected: expected, verdict: 'FAIL',
                      observed: { error_class: e.class.name, message: e.message } }
  end

  def assert(condition, message)
    raise message unless condition
  end

  def git(*)
    stdout, stderr, status = Open3.capture3('git', *, chdir: ROOT)
    raise "Git metadata unavailable: #{stderr}" unless status.success?

    stdout
  end

  def command(label, *arguments, expected_exit: 0)
    stdout, stderr, status = Open3.capture3(*arguments, chdir: ROOT)
    File.write(File.join(@output, "#{label}.stdout"), stdout)
    File.write(File.join(@output, "#{label}.stderr"), stderr)
    @commands << { label: label, argv: arguments, cwd: ROOT, exit_code: status.exitstatus,
                   expected_exit_code: expected_exit, stdout: "#{label}.stdout", stderr: "#{label}.stderr" }
    assert(status.exitstatus == expected_exit,
           "#{label}: expected exit #{expected_exit}, observed #{status.exitstatus}; inspect saved logs")
    stdout + stderr
  end

  def cli(label, *, **)
    command(label, RbConfig.ruby, File.join(ROOT, 'src/bin/paygen'), *, **)
  end

  def generated(name, source: File.join(ROOT, 'fixtures/novapay/openapi.yaml'), profile: nil)
    directory = File.join(@output, name)
    arguments = ['init', source, '--output', directory]
    arguments += ['--profile', profile] if profile
    cli("#{name}-init", *arguments)
    cli("#{name}-generate", 'generate', directory)
    Paygen::Project.new(directory)
  end

  def manifest(directory)
    Dir.glob(File.join(directory, '**/*'), File::FNM_DOTMATCH).sort.filter_map do |path|
      next unless File.file?(path)

      [path.delete_prefix("#{directory}/"), Digest::SHA256.file(path).hexdigest]
    end.to_h
  end

  def write_json(name, data)
    File.write(File.join(@output, name), "#{JSON.pretty_generate(data)}\n")
  end

  def independent_generation
    projects = %w[e02-first e02-second].map { |name| generated(name) }
    hashes = projects.map { |project| manifest(project.path('generated')) }
    assert(!hashes.first.empty? && hashes.first == hashes.last, 'Independent generated file sets or bytes differ')
    assert(projects.first.profile == projects.last.profile, 'Profiles differ')
    { generated_sha256: hashes, files_compared: hashes.first.length,
      source_sha256: Digest::SHA256.file(File.join(ROOT, 'fixtures/novapay/openapi.yaml')).hexdigest,
      profile_sha256: Digest::SHA256.file(projects.first.path('integration.yml')).hexdigest }
  end

  def serialization_equivalence
    document = Paygen::Core::Input.read(File.join(ROOT, 'fixtures/novapay/openapi.yaml'))
    yaml = File.join(@output, 'equivalent.yaml')
    json = File.join(@output, 'equivalent.json')
    File.write(yaml, YAML.dump(document))
    File.write(json, JSON.pretty_generate(document))
    projects = [generated('e03-yaml', source: yaml), generated('e03-json', source: json)]
    semantics = projects.map do |project|
      { ir: project.ir.to_h, config: project.ir.config.except('source_hash'),
        effective_document: project.effective_document,
        fixtures: JSON.parse(File.read(project.path('generated/fixtures.json'))) }
    end
    assert(semantics.first == semantics.last, 'Equivalent serializations changed semantic output')
    semantics.each_with_index { |value, index| write_json("e03-semantics-#{index}.json", value) }
    { yaml_sha256: Digest::SHA256.file(yaml).hexdigest, json_sha256: Digest::SHA256.file(json).hexdigest,
      compared: %w[IR config effective_document fixtures],
      excluded: %w[provenance_bytes config.source_hash project_lock_bytes],
      reason: 'Source serialization/identity and provenance bytes may differ; compare parsed semantic values' }
  end

  def ownership
    drift = generated('e04-drift')
    target = drift.path('generated/novapay_service.rb')
    File.open(target, 'a') { |file| file.write("\n# Synthetic user edit for drift experiment\n") }
    edited_hash = Digest::SHA256.file(target).hexdigest
    output = cli('e04-drift-refusal', 'generate', drift.root, expected_exit: 1)
    assert(output.include?('GENERATED_DRIFT'), 'Refusal did not identify generated drift')
    assert(Digest::SHA256.file(target).hexdigest == edited_hash, 'Refused generation overwrote the manual edit')
    preserved = generated('e04-extension')
    extension = preserved.path('extensions/user-owned.rb')
    File.write(extension, "# Synthetic user extension, never executed by this experiment\n")
    extension_hash = Digest::SHA256.file(extension).hexdigest
    before = manifest(preserved.path('generated'))
    profile = preserved.profile
    profile.fetch('amount')['minimum'] = 200_000
    preserved.write('integration.yml', YAML.dump(profile))
    cli('e04-extension-regenerate', 'generate', preserved.root)
    assert(Digest::SHA256.file(extension).hexdigest == extension_hash, 'Regeneration changed a user-owned extension')
    assert(before != manifest(preserved.path('generated')), 'Control profile update did not change generated artifacts')
    { refused_edit_sha256: edited_hash, extension_before_sha256: extension_hash,
      extension_after_sha256: Digest::SHA256.file(extension).hexdigest, generated_changed: true }
  end

  def native_profiles
    command('e05-clean-core-before', 'git', 'diff', '--exit-code', 'HEAD', '--', 'src/lib')
    providers = %w[paypal paystack].to_h do |provider|
      fixture = File.join(ROOT, "fixtures/native-#{provider}")
      source = Dir[File.join(fixture, 'openapi.*')].fetch(0)
      profile = File.join(fixture, 'profile.yml')
      project = generated("e05-#{provider}", source: source, profile: profile)
      assert(project.effective_document == Paygen::Core::Input.read(source), "#{provider}: native source was changed")
      assert(Dir[project.path('overlays/*')].empty?, "#{provider}: unexpected overlay")
      [provider, { source_sha256: Digest::SHA256.file(source).hexdigest,
                   profile_sha256: Digest::SHA256.file(profile).hexdigest,
                   generated_sha256: manifest(project.path('generated')),
                   endpoints: project.ir.config.fetch('endpoints').keys.sort,
                   scope: 'Selected payout create/status; not full API or provider sandbox acceptance' }]
    end
    command('e05-native-http-examples', RbConfig.ruby, Gem.bin_path('rspec-core', 'rspec'),
            '--options', 'src/.rspec', '-I', 'src/spec', 'src/spec/native_packs_spec.rb', '--seed', '42', '--format', 'json',
            '--out', File.join(@output, 'e05-native-rspec.json'))
    result = JSON.parse(File.read(File.join(@output, 'e05-native-rspec.json'))).fetch('summary')
    passed = result.fetch('example_count').positive? && result.fetch('failure_count').zero? &&
             result.fetch('pending_count').zero?
    assert(passed,
           'Native tests failed, were skipped, or did not execute')
    command('e05-clean-core-after', 'git', 'diff', '--exit-code', 'HEAD', '--', 'src/lib')
    assert(@core_before == manifest(File.join(ROOT, 'src/lib')), 'Research onboarding changed core files')
    { providers: providers, native_test_summary: result, core_unchanged: true }
  end
end

exit ResearchExperiments.new(ARGV.fetch(0, nil)).run if $PROGRAM_NAME == __FILE__
