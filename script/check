#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
command -v ruby >/dev/null
command -v bundle >/dev/null
command -v npm >/dev/null
command -v docker >/dev/null
bundle check
bundle exec rspec
bundle exec ruby script/verify-package.rb
bundle exec ruby script/acceptance-independent
bundle exec rubocop --only Lint,Security
bundle exec bundler-audit check --update
script/smoke
bundle exec ruby script/architecture-audit.rb
bundle exec ruby script/research-experiments
npm ci --ignore-scripts --engine-strict
npm audit --audit-level=high
npm run docs:test
npm run docs:build
npm ci --prefix tools/bruno --ignore-scripts --engine-strict
npm audit --prefix tools/bruno --audit-level=high
mkdir -p tmp/bruno-verification
PAYGEN_BRUNO_REPORTS=$(mktemp -d tmp/bruno-verification/run.XXXXXX)
rmdir "$PAYGEN_BRUNO_REPORTS"
bundle exec ruby script/verify-bruno.rb --cli tools/bruno/node_modules/@usebruno/cli/bin/bru.js --output "$PAYGEN_BRUNO_REPORTS"
PAYGEN_SOURCE_SHA=$(git rev-parse HEAD)
PAYGEN_SOURCE_DIRTY=clean
if [[ -n "$(git status --porcelain)" ]]; then PAYGEN_SOURCE_DIRTY=dirty; fi
docker build -f src/Dockerfile --build-arg "PAYGEN_SOURCE_SHA=$PAYGEN_SOURCE_SHA" --build-arg "PAYGEN_SOURCE_DIRTY=$PAYGEN_SOURCE_DIRTY" -t paygen-verification .
docker run --rm paygen-verification doctor
docker run --rm --entrypoint bash paygen-verification script/smoke
mkdir -p tmp/container-verification
PAYGEN_CONTAINER_REPORTS=$(mktemp -d "$PWD/tmp/container-verification/run.XXXXXX")
# Producers use the host runner identity so private 0700 project directories
# remain readable by artifact upload without weakening their permissions.
PAYGEN_REPORT_OWNER="$(id -u):$(id -g)"
docker run --rm --entrypoint bundle paygen-verification exec rspec | tee "$PAYGEN_CONTAINER_REPORTS/rspec.log"
docker run --rm --user "$PAYGEN_REPORT_OWNER" --mount "type=bind,src=$PAYGEN_CONTAINER_REPORTS,dst=/evidence" \
  -e PAYGEN_ACCEPTANCE_REPORT=/evidence/independent.json \
  --entrypoint bundle paygen-verification exec ruby script/acceptance-independent
docker run --rm --user "$PAYGEN_REPORT_OWNER" --mount "type=bind,src=$PAYGEN_CONTAINER_REPORTS,dst=/evidence" \
  --entrypoint bash paygen-verification examples/showcase/run /evidence/showcase
docker build --build-arg "PAYGEN_SOURCE_SHA=$PAYGEN_SOURCE_SHA" -f tools/docs/Dockerfile -t paygen-docs-verification .
PAYGEN_DOCS_CONTAINER=$(docker run -d -p 127.0.0.1::80 paygen-docs-verification)
cleanup_docs() {
  local result=$?
  if (( result != 0 )); then docker logs "$PAYGEN_DOCS_CONTAINER" || true; fi
  docker rm -f "$PAYGEN_DOCS_CONTAINER" >/dev/null
  exit "$result"
}
trap cleanup_docs EXIT
PAYGEN_DOCS_PORT=$(docker port "$PAYGEN_DOCS_CONTAINER" 80/tcp | sed 's/.*://')
PAYGEN_DOCS_PAGE=$(curl --retry 5 --retry-all-errors --retry-delay 1 --retry-max-time 20 --connect-timeout 2 --max-time 5 --fail --silent --show-error "http://127.0.0.1:$PAYGEN_DOCS_PORT/paygen/")
[[ "$PAYGEN_DOCS_PAGE" == *Paygen* ]]
PAYGEN_DOCS_MISSING=$(curl --silent --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$PAYGEN_DOCS_PORT/paygen/does-not-exist")
[[ "$PAYGEN_DOCS_MISSING" == 404 ]]
ruby -rjson -e 'puts JSON.pretty_generate(status: "PASS", ruby: RUBY_VERSION, checks: %w[rspec independent_acceptance lint dependency_audit seven_provider_smoke architecture research_e02_e05 diplodoc bruno ruby_oci_full_suite demo_oci docs_oci])'
